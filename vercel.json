{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/:match*",
      "destination": "/api?match=:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
